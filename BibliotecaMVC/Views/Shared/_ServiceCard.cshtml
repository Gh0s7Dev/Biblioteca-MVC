@model BibliotecaMVC.Models.ServiceCard

@{
    var cardTitle = ViewData["CardTitle"]?.ToString() ?? "Servicio";
}

<div class="card-demo">

    <div class="card h-100 shadow-sm">

        <img src="@Model.ImageUrl"
             class="card-img-top"
             alt="@cardTitle">

        <div class="card-body text-center">

            <h5 class="card-title">
                @cardTitle
            </h5>

            <p class="card-text">
                @Model.Text
            </p>

            <a asp-controller="@Model.Controller"
               asp-action="@Model.Action"
               class="btn btn-outline-primary">
                @Model.ButtonText
            </a>

        </div>

    </div>

</div>

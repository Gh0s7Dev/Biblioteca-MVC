@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="container py-5">
    <div class="row justify-content-center text-center">
        <div class="col-lg-7">

            <div class="mb-4">
                <i class="bi bi-shield-lock-fill text-warning"
                   style="font-size: 5rem;"></i>
            </div>

            <h1 class="display-4 fw-bold text-dark">
                Acceso denegado
            </h1>

            <h4 class="text-secondary mt-3">
                No tienes permisos para acceder a esta sección.
            </h4>

            <p class="text-muted mt-3 mb-4">
                Tu cuenta no dispone de los permisos necesarios
                para realizar esta operación.
                Si consideras que se trata de un error,
                contacta con el administrador de la biblioteca.
            </p>

            <div class="d-flex justify-content-center gap-3 flex-wrap">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary px-4">
                    <i class="bi bi-house-door me-2"></i>
                    Ir al inicio
                </a>

                <a asp-controller="Libros"
                   asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    <i class="bi bi-book me-2"></i>
                    Consultar libros
                </a>

            </div>

            <div class="mt-4">
                <span class="badge bg-light text-secondary border p-2">
                    Código de respuesta: 403
                </span>
            </div>

        </div>
    </div>
</div>

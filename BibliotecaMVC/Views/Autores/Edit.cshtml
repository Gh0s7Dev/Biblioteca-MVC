@model BibliotecaMVC.Models.Autor

@{
    ViewData["Title"] = "Editar Autor";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="Edit" method="post" class="swal-save-form">

    <input type="hidden" asp-for="ID" />

    <div class="mb-3">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Apellido"></label>
        <input asp-for="Apellido" class="form-control" />
        <span asp-validation-for="Apellido"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Nacionalidad"></label>
        <input asp-for="Nacionalidad" class="form-control" />
        <span asp-validation-for="Nacionalidad"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaNacimiento"></label>
        <input asp-for="FechaNacimiento" type="date" class="form-control" />
        <span asp-validation-for="FechaNacimiento"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Activo"></label>
        <input asp-for="Activo" type="checkbox" class="form-check-input" />
        <span asp-validation-for="Activo"></span>
    </div>

    <button type="submit" class="btn btn-warning">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary swal-save-form">Cancelar</a>

</form>
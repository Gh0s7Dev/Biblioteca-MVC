@model IEnumerable<BibliotecaMVC.Models.Autor>
@{
    ViewData["Title"] = "Listado de Autores";
}

<h1>@ViewData["Title"]</h1>
<p>Hay @Model.Count() autores registrados.</p>

<a class="btn btn-primary" asp-action="Create">Nuevo Autor +</a>

<div class="row">
    @foreach (var autor in Model)
    {
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5>@autor.Nombre @autor.Apellido</h5>
                    <h6>@autor.Nacionalidad</h6>
                    <p>Edad : @(DateTime.Now.Year - autor.FechaNacimiento.Year)</p>
                    @if (autor.Activo)
                    {
                        <p>
                            <span class="badge bg-success">Activo</span>
                        </p>
                    }
                    else
                    {
                        <p>
                            <span class="badge bg-secondary">Inactivo</span>
                        </p>
                    }

                    <a asp-action="Details" asp-route-id="@autor.ID">Ver</a>
                    <a asp-action="Edit" asp-route-id="@autor.ID">Editar</a>
                    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@autor.ID">Eliminar</a>
                </div>
            </div>
        </div>
    }
</div>
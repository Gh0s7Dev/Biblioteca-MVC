@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Listado de Libros";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h1>@ViewData["Title"]</h1>

<p>Hay @Model.Count() libros registrados.</p>

<a class="btn btn-primary mb-3" asp-action="Create">Nuevo Libro +</a>

<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">

                    <h5>@libro.Titulo</h5>

                    <h6>@libro.Autor</h6>

                    <p>Categoría: @libro.Categoria</p>

                    <p>Precio: $@libro.Precio</p>

                    <p>
                        Estado:
                        @if (libro.Disponible)
                        {
                            <span class="text-success">Disponible</span>
                        }
                        else
                        {
                            <span class="text-danger">No disponible</span>
                        }
                    </p>

                    <a class="btn btn-info"
                       asp-action="Details"
                       asp-route-id="@libro.ID">
                        Ver
                    </a>

                    <a class="btn btn-warning"
                       asp-action="Edit"
                       asp-route-id="@libro.ID">
                        Editar
                    </a>

                    <a class="btn btn-outline-danger"
                       asp-action="Delete"
                       asp-route-id="@libro.ID">
                        Eliminar
                    </a>

                </div>
            </div>
        </div>
    }
</div>


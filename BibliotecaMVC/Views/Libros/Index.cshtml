@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Listado de Libros";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
        <small class="text-muted">(@Model.Count() libros registrados)</small>
    </div>

    @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-danger"
               asp-controller="Reportes"
               asp-action="Reporte"
               target="_blank"
               rel="noopener">
                Abrir reporte
            </a>

            <a class="btn btn-outline-danger"
               asp-controller="Reportes"
               asp-action="DescargarReporte">
                Descargar PDF
            </a>

            <a class="btn btn-outline-success"
               asp-controller="Reportes"
               asp-action="ExportarExcel">
                Exportar Excel
            </a>

            <a class="btn btn-primary"
               asp-action="Create">
                Nuevo Libro +
            </a>
        </div>
    }
</div>

<div class="row">
    @foreach (var libro in Model)
    {
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">

                    <h5>@libro.Titulo</h5>

                    <h6>@libro.Autor</h6>

                    <p>Categoría: @libro.Categoria</p>

                    <p>Precio: $@libro.Precio</p>

                    <p>
                        Estado:
                        @if (libro.Disponible)
                        {
                            <span class="text-success">Disponible</span>
                        }
                        else
                        {
                            <span class="text-danger">No disponible</span>
                        }
                    </p>

                    <a class="btn btn-info"
                       asp-action="Details"
                       asp-route-id="@libro.ID">
                        Ver
                    </a>

                    @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                    {
                        <a class="btn btn-warning"
                           asp-action="Edit"
                           asp-route-id="@libro.ID">
                            Editar
                        </a>

                        <a class="btn btn-outline-danger"
                           asp-action="Delete"
                           asp-route-id="@libro.ID">
                            Eliminar
                        </a>
                    }

                </div>
            </div>
        </div>
    }
</div>
@model BibliotecaMVC.Models.ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center text-center">
        <div class="col-lg-7">

            <div class="mb-4">
                <i class="bi bi-exclamation-triangle-fill text-danger"
                   style="font-size: 5rem;"></i>
            </div>

            <h1 class="display-4 fw-bold text-dark">
                ¡Ups! Algo salió mal
            </h1>

            <h4 class="text-secondary mt-3">
                Ha ocurrido un problema inesperado.
            </h4>

            <p class="text-muted mt-3 mb-4">
                No pudimos completar tu solicitud.
                Puedes regresar al inicio o continuar explorando
                nuestra biblioteca.
            </p>

            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary px-4">
                    <i class="bi bi-house-door me-2"></i>
                    Ir al inicio
                </a>

                <a asp-controller="Libros"
                   asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    <i class="bi bi-book me-2"></i>
                    Explorar libros
                </a>
            </div>

            @if (Model?.ShowRequestId == true)
            {
                <p class="text-muted small mt-4">
                    Código de seguimiento:
                    <code>@Model.RequestId</code>
                </p>
            }

        </div>
    </div>
</div>

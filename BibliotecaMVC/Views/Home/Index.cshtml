<!--BOOTSTRAP -->
<div class="container mt-5">
    <h2 class="text-center mb-4">3. Responsive con Bootstrap</h2>

    <div class="row">
        <!--Servicio 1 -->
        <div class="col-12 col-sm-4 mb-3">
            <div class="card h-100 shadow-sm">
                <img src="https://picsum.photos/400/220?random=1"
                     class="card-img-top"
                     alt="Préstamo de libros">

                <div class="card-body text-center">
                    <h5 class="card-title">Préstamo de libros</h5>

                    <p class="card-text">
                        Consulta y disfruta de nuestra colección de libros disponibles para préstamo."
                    </p>

                    <a asp-controller="Libros"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Ver Libros
                    </a>
                </div>
            </div>
        </div>

        <!--Servicio 2 -->

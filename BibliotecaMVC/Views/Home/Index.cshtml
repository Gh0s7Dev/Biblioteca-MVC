<div class="container mt-5">
    <!-- Hero principal -->
    <div class="row align-items-center">
        <div class="col-md-6">
            <h1 class="display-4 fw-bold">
                Biblioteca Virtual
            </h1>

            <p class="lead">
                Descubre nuevos mundos a través de los libros.
                Explora nuestra colección, conoce diferentes autores
                y encuentra historias para todos los gustos.
            </p>

            <a asp-controller="Home"
               asp-action="About"
               class="btn btn-primary btn-lg">
                Conocer más
            </a>
        </div>

        <div class="col-md-6 text-center mt-4 mt-md-0">
            <img src="https://picsum.photos/600/400"
                 class="img-fluid rounded shadow"
                 alt="Biblioteca Virtual" />
        </div>
    </div>
</div>


<!-- SIN RESPONSIVE -->
<div class="section">
    <h2 class="text-center mb-4">1. Sin Responsive</h2>

    <div class="contenedor sin-responsive">
        @await Html.PartialAsync("_ServiceCard", new BibliotecaMVC.Models.ServiceCard {ImageUrl = "https://picsum.photos/400/220?random=1", Text = "(1) Consulta y disfruta de nuestra colección de libros disponibles para préstamo."})
        @await Html.PartialAsync("_ServiceCard", new BibliotecaMVC.Models.ServiceCard { ImageUrl = "https://picsum.photos/400/220?random=1", Text = "(2) Consulta y disfruta de nuestra colección de libros disponibles para préstamo." })
        @await Html.PartialAsync("_ServiceCard", new BibliotecaMVC.Models.ServiceCard { ImageUrl = "https://picsum.photos/400/220?random=1", Text = "(3) Consulta y disfruta de nuestra colección de libros disponibles para préstamo." })
    </div>
</div>


<!-- Estadísticas -->
<div class="container mt-5">
    <div class="row text-center g-4">

        <div class="col-12 col-md-4">
            <div class="p-4 bg-light rounded shadow-sm">
                <h2 class="text-primary fw-bold">500+</h2>
                <p class="mb-0">Libros disponibles</p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="p-4 bg-light rounded shadow-sm">

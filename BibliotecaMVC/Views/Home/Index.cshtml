<div class="container mt-5">
    <!-- Hero principal -->
    <div class="row align-items-center">
        <div class="col-md-6">
            <h1 class="display-4 fw-bold">
                Biblioteca Virtual
            </h1>

            <p class="lead">
                Descubre nuevos mundos a través de los libros.
                Explora nuestra colección, conoce diferentes autores
                y encuentra historias para todos los gustos.
            </p>

            <a asp-controller="Home"
               asp-action="About"
               class="btn btn-primary btn-lg">
                Conocer más
            </a>
        </div>

        <div class="col-md-6 text-center mt-4 mt-md-0">
            <img src="https://picsum.photos/600/400"
                 class="img-fluid rounded shadow"
                 alt="Biblioteca Virtual" />
        </div>
    </div>
</div>


<!-- Servicios -->
<div class="container mt-5">
    <h2 class="text-center mb-4">Servicios de la Biblioteca</h2>

    <div class="row g-4">

        <!-- Servicio 1 -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <img src="https://picsum.photos/400/220?random=1"
                     class="card-img-top"
                     alt="Préstamo de libros">

                <div class="card-body text-center">
                    <h5 class="card-title">Préstamo de libros</h5>

                    <p class="card-text">
                        Consulta y disfruta de nuestra colección
                        de libros disponibles para préstamo.
                    </p>

                    <a asp-controller="Libros"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Ver Libros
                    </a>
                </div>
            </div>
        </div>

        <!-- Servicio 2 -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <img src="https://picsum.photos/400/220?random=2"
                     class="card-img-top"
                     alt="Catálogo de libros">

                <div class="card-body text-center">
                    <h5 class="card-title">Catálogo virtual</h5>

                    <p class="card-text">
                        Explora nuestro catálogo y encuentra libros
                        organizados por categorías y autores.
                    </p>

                    <a asp-controller="Libros"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Ver catálogo
                    </a>
                </div>
            </div>
        </div>

        <!-- Servicio 3 -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <img src="https://picsum.photos/400/220?random=3"
                     class="card-img-top"
                     alt="Autores">

                <div class="card-body text-center">
                    <h5 class="card-title">Autores</h5>

                    <p class="card-text">
                        Conoce autores destacados y descubre
                        sus principales obras literarias.
                    </p>

                    <a asp-controller="Autores"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Ver autores
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Estadísticas -->
<div class="container mt-5">
    <div class="row text-center g-4">

        <div class="col-12 col-md-4">
            <div class="p-4 bg-light rounded shadow-sm">
                <h2 class="text-primary fw-bold">500+</h2>
                <p class="mb-0">Libros disponibles</p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="p-4 bg-light rounded shadow-sm">
                <h2 class="text-primary fw-bold">120+</h2>
                <p class="mb-0">Autores registrados</p>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="p-4 bg-light rounded shadow-sm">
                <h2 class="text-primary fw-bold">25+</h2>
                <p class="mb-0">Categorías literarias</p>
            </div>
        </div>

    </div>
</div>


<!-- Categorías -->
<div class="container mt-5">
    <h2 class="text-center mb-4">Categorías Literarias</h2>

    <div class="row g-3 text-center">

        <div class="col-6 col-md-3">
            <div class="border rounded p-3 shadow-sm">
                <h5>Novela</h5>
                <p class="mb-0">Historias y ficción</p>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="border rounded p-3 shadow-sm">
                <h5>Ciencia</h5>
                <p class="mb-0">Conocimiento y descubrimiento</p>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="border rounded p-3 shadow-sm">
                <h5>Historia</h5>
                <p class="mb-0">Pasado y cultura</p>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="border rounded p-3 shadow-sm">
                <h5>Poesía</h5>
                <p class="mb-0">Arte y literatura</p>
            </div>
        </div>

    </div>
</div>


<!-- Llamada a la acción -->
<div class="container mt-5 mb-5">
    <div class="bg-primary text-white rounded p-5 text-center shadow">

        <h2>Explora nuestra Biblioteca Virtual</h2>

        <p class="mt-3">
            Encuentra nuevos libros, descubre autores y amplía
            tus conocimientos a través de nuestra colección.
        </p>

        <a asp-controller="Home"
           asp-action="About"
           class="btn btn-outline-light btn-lg">
            Acerca de la Biblioteca
        </a>

    </div>
</div>
@{
    ViewData["Title"] = "Inicio";
}

<!-- ================================
     HERO PRINCIPAL
     ================================ -->

<div class="container mt-5">

    <div class="row align-items-center">

        <div class="col-md-6">
            <h1 class="display-4 fw-bold">
                Biblioteca Virtual
            </h1>

            <p class="lead">
                Descubre nuevos mundos a través de los libros.
                Explora nuestra colección, conoce diferentes autores
                y encuentra historias para todos los gustos.
            </p>

            <a asp-controller="Home"
               asp-action="About"
               class="btn btn-primary btn-lg">
                Conocer más
            </a>
        </div>

        <div class="col-md-6 text-center mt-4 mt-md-0">

            <img src="https://picsum.photos/600/400"
                 class="img-fluid rounded shadow"
                 alt="Biblioteca Virtual" />

        </div>

    </div>

</div>


<!-- ================================
     ACTIVIDAD 1 - FLEXBOX
     ================================ -->

<section class="section">

    <h2 class="text-center mb-4">
        Servicios de la Biblioteca
    </h2>

    <div class="contenedor flex-layout">

        @await Html.PartialAsync(
            "_ServiceCard",
            new BibliotecaMVC.Models.ServiceCard
            {
                ImageUrl = "https://picsum.photos/400/220?random=1",
                Text = "Consulta y disfruta de nuestra colección de libros disponibles para préstamo."
            },
            new ViewDataDictionary<BibliotecaMVC.Models.ServiceCard>(ViewData)
            {
                ["CardTitle"] = "Préstamo de libros"
            }
        )

        @await Html.PartialAsync(
            "_ServiceCard",
            new BibliotecaMVC.Models.ServiceCard
            {
                ImageUrl = "https://picsum.photos/400/220?random=2",
                Text = "Conoce diferentes autores y descubre información sobre sus obras."
            },
            new ViewDataDictionary<BibliotecaMVC.Models.ServiceCard>(ViewData)
            {
                ["CardTitle"] = "Autores"
            }
        )

        @await Html.PartialAsync(
            "_ServiceCard",
            new BibliotecaMVC.Models.ServiceCard
            {
                ImageUrl = "https://picsum.photos/400/220?random=3",
                Text = "Explora nuestra colección organizada por diferentes categorías literarias."
            },
            new ViewDataDictionary<BibliotecaMVC.Models.ServiceCard>(ViewData)
            {
                ["CardTitle"] = "Categorías"
            }
        )

    </div>

</section>


<!-- ================================
     ACTIVIDAD 2 - CSS GRID
     ================================ -->

<section class="section">

    <h2 class="text-center mb-4">
        Biblioteca Virtual
    </h2>

    <div class="contenedor grid-layout">

        <div class="grid-card">
            <h3>Literatura</h3>
            <p>
                Obras literarias clásicas y contemporáneas
                para todos los gustos.
            </p>
        </div>

        <div class="grid-card">
            <h3>Ciencia</h3>
            <p>
                Libros relacionados con ciencia,
                tecnología y conocimiento.
            </p>
        </div>

        <div class="grid-card">
            <h3>Historia</h3>
            <p>
                Conoce acontecimientos, culturas y
                personajes históricos.
            </p>
        </div>

        <div class="grid-card">
            <h3>Poesía</h3>
            <p>
                Obras poéticas y diferentes expresiones
                del arte literario.
            </p>
        </div>

    </div>

</section>


<!-- ================================
     ESTADÍSTICAS
     ================================ -->

<div class="container mt-5">

    <div class="row text-center g-4">

        <div class="col-12 col-md-4">
            <div class="p-4 bg-light rounded shadow-sm">

                <h2 class="text-primary fw-bold">
                    500+
                </h2>

                <p class="mb-0">
                    Libros disponibles
                </p>

            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="p-4 bg-light rounded shadow-sm">

                <h2 class="text-primary fw-bold">
                    120+
                </h2>

                <p class="mb-0">
                    Autores registrados
                </p>

            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="p-4 bg-light rounded shadow-sm">

                <h2 class="text-primary fw-bold">
                    25+
                </h2>

                <p class="mb-0">
                    Categorías literarias
                </p>

            </div>
        </div>

    </div>

</div>


<!-- ================================
     LLAMADA A LA ACCIÓN
     ================================ -->

<div class="container mt-5 mb-5">

    <div class="bg-primary text-white rounded p-5 text-center shadow">

        <h2>
            Explora nuestra Biblioteca Virtual
        </h2>

        <p class="mt-3">
            Encuentra nuevos libros, descubre autores y amplía
            tus conocimientos a través de nuestra colección.
        </p>

        <a asp-controller="Home"
           asp-action="About"
           class="btn btn-outline-light btn-lg">
            Acerca de la Biblioteca
        </a>

    </div>

</div>
